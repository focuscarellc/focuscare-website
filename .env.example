# Public project token and ingestion host. Configure the intended Focus Care project.
# Leave blank to keep analytics disabled without affecting the website.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Server-only contact delivery. CONTACT_DB is a D1 binding, not a string.
# Reuse the existing verified Focus Care sender. Never put these in public variables.
RESEND_API_KEY=
CONTACT_FORM_SECRET=
